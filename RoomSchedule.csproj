<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RoomSchedule</RootNamespace>
    <AssemblyName>RoomSchedule</AssemblyName>
    <!-- Кириллица в исходниках и расписании: оставляем культурозависимое поведение. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <!-- Сторонних NuGet-пакетов нет: проект собирается одним только .NET SDK. -->

</Project>
